#!/command/with-contenv sh
set -e
. /etc/s6-overlay/scripts/env.sh
export GOTRUE_API_HOST=127.0.0.1 GOTRUE_API_PORT=9999
export API_EXTERNAL_URL="$PUBLIC_URL" GOTRUE_SITE_URL="$PUBLIC_URL" GOTRUE_URI_ALLOW_LIST="${PUBLIC_URL}/**"
export GOTRUE_DB_DRIVER=postgres GOTRUE_DB_MIGRATIONS_PATH=/opt/gotrue-migrations
export GOTRUE_DB_DATABASE_URL="postgres://supabase_auth_admin:${POSTGRES_PASSWORD}@127.0.0.1:5432/postgres"
export GOTRUE_JWT_SECRET="$JWT_SECRET" GOTRUE_JWT_EXP=3600 GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated GOTRUE_JWT_AUD=authenticated
export GOTRUE_DISABLE_SIGNUP=false GOTRUE_MAILER_AUTOCONFIRM="${AUTO_CONFIRM:-false}"
export GOTRUE_SMTP_HOST="${SMTP_HOST:-}" GOTRUE_SMTP_PORT="${SMTP_PORT:-587}" GOTRUE_SMTP_USER="${SMTP_USER:-}" GOTRUE_SMTP_PASS="${SMTP_PASS:-}" GOTRUE_SMTP_ADMIN_EMAIL="${SMTP_FROM:-noreply@localhost}"
exec /opt/bin/gotrue
